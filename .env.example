# Copy to .env.local and fill in values. Never commit .env.local.
# Secrets (also set the first three in Vercel: Production + Preview)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# Local only (never in Vercel): Supabase "Session pooler" connection string (IPv4)
SUPABASE_DB_URL=
# Non-secret config
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional daily AI limits: receipt scans per group (30), type-to-add per group (50), all AI calls app-wide (300)
SCAN_LIMIT_PER_GROUP=
SCAN_LIMIT_PER_APP=
NL_LIMIT_PER_GROUP=
